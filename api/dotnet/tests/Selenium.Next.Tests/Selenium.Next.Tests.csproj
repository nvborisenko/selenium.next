<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.87.12" />
  </ItemGroup>

  <!-- Dev convenience: pick up the natively built core from the Cargo target dir. -->
  <ItemGroup>
    <None Include="../../../../core/selenium-ffi/target/debug/libselenium_next_core.dylib" Condition="Exists('../../../../core/selenium-ffi/target/debug/libselenium_next_core.dylib')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../../../../core/selenium-ffi/target/debug/libselenium_next_core.so" Condition="Exists('../../../../core/selenium-ffi/target/debug/libselenium_next_core.so')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../../../../core/selenium-ffi/target/debug/selenium_next_core.dll" Condition="Exists('../../../../core/selenium-ffi/target/debug/selenium_next_core.dll')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Selenium.Next\Selenium.Next.csproj" />
  </ItemGroup>

</Project>
